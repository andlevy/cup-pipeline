// =============================================================================
// CUP WES Pipeline -- Local Nextflow Configuration
// nf-core/sarek 3.8.1
// =============================================================================
// Machine: cssd028012
// CPUs:    64 (capped at 52 to leave headroom for OS and other users)
// RAM:     125GB (capped at 100GB)
// =============================================================================

// --- Executor ----------------------------------------------------------------

executor {
    name   = 'local'
    cpus   = 52
    memory = '100.GB'
}

// --- Resource caps -----------------------------------------------------------

params {
    max_cpus   = 52
    max_memory = '100.GB'
    max_time   = '240.h'
}

// --- Singularity -------------------------------------------------------------

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--bind /mnt'
}

// --- Nextflow work directory -------------------------------------------------

workDir = '/mnt/913bddcf-fa31-4a34-a763-fbc307b90cde/tmp/nextflow_work'

// --- Process-specific resource overrides -------------------------------------
// WES data is much lighter than WGS -- override the Sarek WGS defaults

process {
    errorStrategy = { task.exitStatus in [130, 137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'BWAMEM2_MEM' {
        cpus   = 16
        memory = '32.GB'
    }
    withName: 'GATK4_MARKDUPLICATES' {
        cpus   = 4
        memory = '32.GB'
    }
    withName: 'GATK4_MUTECT2' {
        cpus   = 4
        memory = '16.GB'
    }
    withName: 'CNVKIT_BATCH' {
        cpus   = 8
        memory = '16.GB'
    }
    withName: 'ENSEMBLVEP_VEP' {
        cpus   = 8
        memory = '32.GB'
    }
}