// =============================================================================
// CUP RNA Pipeline -- Local Nextflow Configuration
// nf-core/rnaseq 3.23.0
// =============================================================================
// Machine: cssd028012
// CPUs:    64 (capped at 52 to leave headroom for OS and other users)
// RAM:     125GB (capped at 100GB)
// =============================================================================

// --- Executor ----------------------------------------------------------------

executor {
    name   = 'local'
    cpus   = 52
    memory = '100.GB'
}

// --- Singularity -------------------------------------------------------------

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--bind /mnt'
}

// --- Nextflow work directory -------------------------------------------------

workDir = '/mnt/913bddcf-fa31-4a34-a763-fbc307b90cde/tmp/nextflow_work'

// --- Process-specific resource overrides -------------------------------------
// STAR requires ~32GB RAM to load the GRCh38 genome index. At 40GB per process,
// two samples can align concurrently (2x40=80GB) within the 100GB cap.

process {
    errorStrategy = { task.exitStatus in [130, 137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'STAR_GENOMEGENERATE'   { cpus = 8;  memory = '40.GB' }
    withName: 'STAR_ALIGN'            { cpus = 16; memory = '40.GB' }
    withName: 'TRIMGALORE'            { cpus = 8;  memory = '8.GB'  }
    withName: 'SALMON_QUANT'          { cpus = 8;  memory = '12.GB' }
    withName: 'FASTQC'                { cpus = 4;  memory = '4.GB'  }
    withName: 'MULTIQC'               { cpus = 2;  memory = '8.GB'  }
    withName: 'SUBREAD_FEATURECOUNTS'    { cpus = 4;  memory = '16.GB' }
    withName: 'RSEQC_READDUPLICATION'   { cpus = 4;  memory = { 20.GB * task.attempt } }
}
